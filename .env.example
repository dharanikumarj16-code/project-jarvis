# API Keys
# Add your keys here. We use Gemini as the primary LLM model.
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Layer 2: Fast-NLP Semantic Router (fastembed / ONNX bge-small)
JARVIS_ROUTER_SEMANTIC=true
JARVIS_ROUTER_SEMANTIC_THRESHOLD=0.78

# Layer 3: Local Brain (Micro-Reasoning SLM)
# Backends: "llama_cpp" (direct GGUF, no Ollama needed), "ollama", or "auto"
JARVIS_LOCAL_BRAIN_ENABLED=true
JARVIS_LOCAL_BRAIN_BACKEND=auto
JARVIS_LOCAL_BRAIN_GGUF_PATH=models/functiongemma-270m.gguf
JARVIS_LOCAL_BRAIN_THREADS=4
JARVIS_LOCAL_BRAIN_GPU_LAYERS=0
JARVIS_OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_LOCAL_BRAIN_MODEL=smollm2:135m
